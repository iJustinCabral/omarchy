 };
 
 
@@ -292,6 +294,15 @@
 	bus->ops->remove(bus->dev);
 }
 
+static inline
+void brcmf_bus_d2h_mb_rx(struct brcmf_bus *bus, u32 data)
+{
+	if (!bus->ops->d2h_mb_rx)
+		return;
+
+	bus->ops->d2h_mb_rx(bus->dev, data);
+}
