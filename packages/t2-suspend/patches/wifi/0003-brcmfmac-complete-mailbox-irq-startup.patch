+/* The PCIe accessor uses the fixed enumeration aperture, independently of
+ * the selected backplane core. Firmware selects the doorbells via DAR.
+ */
+static u32 brcmf_pcie_h2d_doorbell(struct brcmf_pciedev_info *devinfo, bool ready)
+{
+	if (!devinfo->shared.mb_via_ctl)
+		return ready ? devinfo->reginfo->h2d_mailbox_1 :
+			       devinfo->reginfo->h2d_mailbox_0;
+	if (devinfo->shared.flags & BRCMF_PCIE_SHARED_DAR)
+		return ready ? BRCMF_PCIE_64_PCIE2REG_H2D_MAILBOX_1 :
+			       BRCMF_PCIE_64_PCIE2REG_H2D_MAILBOX_0;
+	return ready ? BRCMF_PCIE_PCIE2REG_H2D_MAILBOX_1 :
+		       BRCMF_PCIE_PCIE2REG_H2D_MAILBOX_0;
+}
