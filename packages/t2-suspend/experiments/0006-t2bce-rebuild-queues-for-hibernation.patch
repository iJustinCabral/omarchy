 static int t2audio_pm_prepare_client(void *userdata)
 {
-    return t2audio_quiesce(userdata, true);
+    struct t2audio_device *t2audio = userdata;
+    int status;
+
+    status = t2audio_quiesce(t2audio, true);
+    if (!status && t2audio_bce_has_pending(t2audio)) {
+        dev_err(t2audio->dev, "pending audio commands after PM quiesce\n");
+        status = -EBUSY;
+    }
+    return status;
+}
+
+static void t2audio_pm_abort_client(void *userdata)
+{
+    struct t2audio_device *t2audio = userdata;
+
+    if (!t2audio->pm_quiesced)
+        return;
+    if (t2audio_cmd_set_remote_access(t2audio, T2AUDIO_REMOTE_ACCESS_ON)) {
+        dev_err(t2audio->dev, "Failed to restore remote access after PM abort\n");
+        return;
+    }
+    t2audio->pm_quiesced = false;
+    t2audio_reset_streams(t2audio);
+}
+
+static void t2audio_pm_drop_no_state_queues(void *userdata)
+{
+    t2audio_bce_destroy(userdata);
+}
+
+static int t2audio_pm_rebuild_no_state_queues(void *userdata)
+{
+    return t2audio_bce_init(userdata);
 }
 
