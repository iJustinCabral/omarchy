     }
     if ((status = t2audio_bce_queue_init(dev, &bce->qin, "com.apple.BridgeAudio.ARMToIntel", DMA_FROM_DEVICE,
             t2audio_bce_in_queue_completion))) {
-        return status;
+        goto fail;
     }
     t2audio_bce_in_queue_submit_pending(&bce->qin, bce->qin.el_count);
     return 0;
