+static void bce_pm_drop_no_state_queue_graph(struct t2bce_device *bce)
+{
+    /* SLEEP_NO_STATE has stopped the remote producer.  Drain any handler that
+     * entered before the sleep request, then free host objects without asking
+     * the now-stateless firmware to unregister them.
+     */
+    synchronize_irq(pci_irq_vector(bce->pci, 4));
+    bce->dma.is_being_removed = true;
+    t2bce_core_clients_pm_drop_no_state_queues(bce);
+    bce_free_command_queues(bce);
+    bce->dma.is_being_removed = false;
+    bce->no_state_queues_dropped = true;
+}
+
+static int bce_pm_rebuild_no_state_queue_graph(struct t2bce_device *bce)
+{
+    int status;
+
+    status = bce_fw_version_handshake(bce);
+    if (status) {
+        bce->no_state_rebuild_failed = true;
+        pr_err("t2bce_core: no-state firmware handshake failed: %d\n", status);
+        return status;
+    }
+
+    status = bce_create_command_queues(bce);
+    if (status) {
+        bce->no_state_rebuild_failed = true;
+        pr_err("t2bce_core: no-state command-queue rebuild failed: %d\n", status);
+        return status;
+    }
+
+    status = t2bce_core_clients_pm_rebuild_no_state_queues(bce);
+    if (!status) {
+        bce->no_state_queues_dropped = false;
+        bce->no_state_rebuild_failed = false;
+        return 0;
+    }
+
+    pr_err("t2bce_core: no-state client-queue rebuild failed: %d\n", status);
+    synchronize_irq(pci_irq_vector(bce->pci, 4));
+    bce->dma.is_being_removed = true;
+    t2bce_core_clients_pm_drop_no_state_queues(bce);
+    bce_free_command_queues(bce);
+    bce->dma.is_being_removed = false;
+    bce->no_state_rebuild_failed = true;
+    return status;
+}
+
+static int bce_pm_suspend_no_state(struct t2bce_device *bce)
+{
