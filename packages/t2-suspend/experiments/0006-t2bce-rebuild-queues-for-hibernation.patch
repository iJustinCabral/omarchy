+static void t2audio_bce_queue_destroy(struct t2audio_device *dev, struct t2audio_bce_queue *q)
+{
+    if (q->data)
+        dma_free_coherent(t2bce_core_client_dma_dev(dev->bce),
+                q->el_size * q->el_count, q->data, q->dma_addr);
+    if (q->sq)
+        t2bce_core_destroy_sq(dev->bce, q->sq);
+    memset(q, 0, sizeof(*q));
+}
+
+void t2audio_bce_destroy(struct t2audio_device *dev)
+{
+    struct t2audio_bce *bce = &dev->bcem;
+
+    t2audio_bce_queue_destroy(dev, &bce->qin);
+    t2audio_bce_queue_destroy(dev, &bce->qout);
+    if (bce->cq)
+        t2bce_core_destroy_cq(dev->bce, bce->cq);
+    bce->cq = NULL;
+    memset(bce->pending_entries, 0, sizeof(bce->pending_entries));
+}
+
+bool t2audio_bce_has_pending(struct t2audio_device *dev)
+{
+    struct t2audio_bce *bce = &dev->bcem;
+    unsigned long flags;
+    bool pending = false;
+    size_t i;
+
+    spin_lock_irqsave(&bce->spinlock, flags);
+    for (i = 0; i < ARRAY_SIZE(bce->pending_entries); i++)
+        if (bce->pending_entries[i]) {
+            pending = true;
+            break;
+        }
+    spin_unlock_irqrestore(&bce->spinlock, flags);
+    return pending;
+}
