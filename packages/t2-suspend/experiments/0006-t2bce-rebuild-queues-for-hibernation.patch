+static int t2audio_refresh_bs_mapping(struct t2audio_device *a)
+{
+    resource_size_t bs_bar_len;
+    u32 ver, sig, bs_base;
+
+    ver = ioread32(&a->reg_mem_gpr[0]);
+    if (ver < 3) {
+        dev_err(a->dev, "t2bce_audio: Bad GPR version (%u)", ver);
+        return -EINVAL;
+    }
+    sig = ioread32(&a->reg_mem_gpr[1]);
+    if (sig != T2AUDIO_SIG) {
+        dev_err(a->dev, "t2bce_audio: Bad GPR sig (%x)", sig);
+        return -EINVAL;
+    }
+    bs_base = ioread32(&a->reg_mem_gpr[2]);
+    bs_bar_len = pci_resource_len(a->pci, 0);
+    if (bs_base > bs_bar_len || sizeof(*a->bs) > bs_bar_len - bs_base) {
+        dev_err(a->dev, "t2bce_audio: BufferStruct offset outside BAR (%x)\n",
+                bs_base);
+        return -ERANGE;
+    }
+    a->bs = (struct t2audio_buffer_struct *)((u8 *)a->reg_mem_bs + bs_base);
+    if (a->bs->signature != T2AUDIO_SIG) {
+        dev_err(a->dev, "t2bce_audio: Bad BufferStruct sig (%x)", a->bs->signature);
+        return -EINVAL;
+    }
+
+    return 0;
+}
