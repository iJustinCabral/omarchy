#!/bin/bash

build() {
  local helper=${OMARCHY_T2_CANDIDATE_BLUETOOTH_HELPER:-}
  if [[ -z $helper || ! -f $helper ]]; then
    error "Missing candidate Bluetooth userspace gate"
    exit 1
  fi
  add_runscript || exit 1
  add_file "$helper" /usr/lib/omarchy-t2-hibernation-candidate/bluetooth-after-wifi.py 700 || exit 1
}

help() {
  echo "Carry the private hci_bcm4377 module through /run for delayed loading after Wi-Fi readiness."
}
