run_hook() {
  local file=${OMARCHY_T2_COLD_PRE_CPU_ROOT:-}/usr/lib/omarchy-t2-cold-pci-pre-arch/functions
  if [[ ! -f $file || -L $file ]]; then
    err "omarchy-t2-cold-pci-pre-arch: missing diagnostic functions after resume"
    launch_interactive_shell --exec
    exit 1
  fi
  . "$file"
  if ! pg_capture_return; then
    pg_recovery "exact recovered guard and interception not proved"
    return 1
  fi
  if [[ -e $pg_intent ]]; then
    pg_recovery "controlled abort returned and combined EFI witness verified"
    return 1
  fi
}
