run_hook() {
  local file=${OMARCHY_T2_COLD_PRE_CPU_ROOT:-}/usr/lib/omarchy-t2-cold-pci-pre-arch/functions
  if [[ ! -f $file || -L $file ]]; then
    err "omarchy-t2-cold-pci-pre-arch: missing diagnostic functions"
    launch_interactive_shell --exec
    exit 1
  fi
  . "$file"
  if ! pg_prepare; then
    pg_recovery "arming failed (${pg_failure:-unknown})"
    return 1
  fi
}
