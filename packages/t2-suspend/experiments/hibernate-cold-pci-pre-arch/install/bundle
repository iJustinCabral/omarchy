build_pci_pre_arch_bundle() {
  local bundle=${OMARCHY_T2_COLD_PCI_ABORT_BUNDLE:-} name destination=/usr/lib/omarchy-t2-cold-pci-pre-arch
  [[ -d $bundle && ! -L $bundle ]] || return 1
  for name in functions abort.ko abort.sha256 abort.srcversion guard.ko guard.sha256 guard.srcversion restore.variable header-reader header-reader.sha256 resume.device resume.offset resume.devnum stock-resume stock-resume.sha256; do
    [[ -f $bundle/$name && ! -L $bundle/$name ]] || return 1
  done
  add_binary "$bundle/header-reader" "$destination/header-reader" 700 || return 1
  for name in functions abort.ko abort.sha256 abort.srcversion guard.ko guard.sha256 guard.srcversion restore.variable header-reader.sha256 resume.device resume.offset resume.devnum stock-resume stock-resume.sha256; do
    add_file "$bundle/$name" "$destination/$name" 600 || return 1
  done
}
