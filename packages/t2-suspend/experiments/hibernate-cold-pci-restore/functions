# Private full-restore protocol; sourced only by its own mkinitcpio hooks.
fr_paths() {
  fr_root=${OMARCHY_T2_COLD_PCI_RESTORE_ROOT:-}
  fr_dir=$fr_root/usr/lib/omarchy-t2-cold-pci-restore
  fr_vars=$fr_root/sys/firmware/efi/efivars
  fr_guid=5e17d2ad-021f-4d45-a8e5-f4c191983e27
  fr_guard=$fr_root/sys/module/mba_hibernate_cold_pci_guard
  fr_intent=$fr_root/run/omarchy-t2-cold-pci-restore.intent
  fr_failure=paths
  [[ -d $fr_dir && ! -L $fr_dir ]] || return 1
  [[ -f $fr_dir/restore.variable && ! -L $fr_dir/restore.variable ]] || return 1
  read -r fr_variable < "$fr_dir/restore.variable" || return 1
  [[ $fr_variable == "OmarchyT2RestoreStageV2-$fr_guid" ]] || return 1
  fr_marker=$fr_vars/$fr_variable
}

fr_order() {
  local hook phase=0 encrypted=0 other
  for hook in $HOOKS; do
    case $hook in
      encrypt) [[ $phase == "0" && $encrypted == "0" ]] || return 1; encrypted=1 ;;
      omarchy-t2-cold-pci-restore) [[ $phase == "0" && $encrypted == "1" ]] || return 1; phase=1 ;;
      omarchy-t2-restore-marker) [[ $phase == "1" ]] || return 1; phase=2 ;;
      resume) [[ $phase == "2" ]] || return 1; phase=3 ;;
      omarchy-t2-cold-pci-restore-stop) [[ $phase == "3" ]] || return 1; phase=4 ;;
      omarchy-t2-cold-*) return 1 ;;
      *) [[ $phase == "0" || $phase == "4" ]] || return 1 ;;
    esac
  done
  [[ $phase == "4" ]] || return 1
  for other in "$EARLYHOOKS" "$LATEHOOKS" "$CLEANUPHOOKS" "$EMERGENCYHOOKS"; do
    for hook in $other; do
      case $hook in omarchy-t2-cold-*|omarchy-t2-restore-marker|resume) return 1 ;; esac
    done
  done
}

fr_hash() {
  local expected actual pin=$1.sha256
  case $1 in guard.ko) pin=${1%.ko}.sha256 ;; esac
  [[ -f $fr_dir/$1 && ! -L $fr_dir/$1 && -f $fr_dir/$pin && ! -L $fr_dir/$pin ]] || return 1
  read -r expected < "$fr_dir/$pin" || return 1
  [[ ${#expected} == "64" ]] || return 1
  case $expected in *[!0-9a-f]*) return 1 ;; esac
  actual=$(sha256sum "$fr_dir/$1") || return 1
  [[ ${actual%% *} == "$expected" ]]
}

fr_header_gate() {
  local tracing device offset devnum commandline token count=0 offsets=0 actual
  fr_failure=header-contract
  tracing=$(set -o pipefail; cat "$fr_root/proc/sys/kernel/ftrace_enabled" | hexdump -v -e '/1 "%02x"') || return 1
  [[ $tracing == "310a" ]] || return 1
  fr_order || return 1
  for token in resume.device resume.offset resume.devnum; do
    [[ -f $fr_dir/$token && ! -L $fr_dir/$token ]] || return 1
  done
  read -r device < "$fr_dir/resume.device" || return 1
  read -r offset < "$fr_dir/resume.offset" || return 1
  read -r devnum < "$fr_dir/resume.devnum" || return 1
  [[ $device == "/dev/mapper/root" && $offset == "1923214" && $devnum == "253:0" ]] || return 1
  read -r actual < "$fr_root/sys/power/resume_offset" || return 1
  [[ $actual == "$offset" ]] || return 1
  read -r commandline < "$fr_root/proc/cmdline" || return 1
  for token in $commandline; do
    case $token in
      resume=*) [[ ${token#resume=} == "$device" ]] || return 1; count=$((count + 1)) ;;
      resume_offset=*) [[ ${token#resume_offset=} == "$offset" ]] || return 1; offsets=$((offsets + 1)) ;;
      noresume|noresume=*|hibernate=noresume|hibernate=no|disablehooks=*) return 1 ;;
    esac
  done
  [[ $count == "1" && $offsets == "1" && -x $fr_dir/header-reader ]] || return 1
  fr_hash header-reader || return 1
  fr_header=$("$fr_dir/header-reader" "$device" "$offset" "253" "0") || return 1
  case $fr_header in NORMAL|PENDING) return 0 ;; *) return 1 ;; esac
}

fr_conflicts() {
  local module
  for module in mba_hibernate_cold_pre_arch mba_hibernate_cold_pre_cpu mba_hibernate_cold_pre_syscore mba_hibernate_cold_pre_relocate t2bce_core t2bce_audio t2bce_vhci t2bce_ave; do
    [[ ! -e $fr_root/sys/module/$module && ! -L $fr_root/sys/module/$module ]] || return 1
  done
}

fr_pci() {
  local function id vendor device driver expected path
  for function in 0 1 2 3; do
    path=$fr_root/sys/bus/pci/devices/0000:74:00.$function
    case $function in 0) id=0x2005; expected=nvme ;; 1) id=0x1801; expected=$1 ;; 2) id=0x1802; expected= ;; 3) id=0x1803; expected= ;; esac
    read -r vendor < "$path/vendor" || return 1
    read -r device < "$path/device" || return 1
    [[ $vendor == "0x106b" && $device == "$id" ]] || return 1
    if [[ -n "$expected" ]]; then
      [[ -L $path/driver ]] || return 1
      driver=$(readlink "$path/driver") || return 1
      [[ ${driver##*/} == "$expected" ]] || return 1
      if [[ $function == "1" ]]; then
        driver=$(readlink "$path/driver/module") || return 1
        [[ ${driver##*/} == "mba_hibernate_cold_pci_guard" ]] || return 1
      fi
    else
      [[ ! -e $path/driver && ! -L $path/driver ]] || return 1
    fi
  done
}

fr_identity() {
  local expected actual
  fr_hash guard.ko || return 1
  [[ -f $fr_dir/guard.srcversion && ! -L $fr_dir/guard.srcversion ]] || return 1
  read -r expected < "$fr_dir/guard.srcversion" || return 1
  read -r actual < "$fr_guard/srcversion" || return 1
  [[ -n $expected && $actual == "$expected" ]] || return 1
  fr_conflicts && fr_pci mba_hibernate_cold_pci_guard
}

fr_params() {
  local armed consumed prefix gates active failed
  read -r armed < "$fr_guard/parameters/arm_prefix" || return 1
  read -r consumed < "$fr_guard/parameters/arm_consumed" || return 1
  read -r prefix < "$fr_guard/parameters/vector_prefix" || return 1
  read -r gates < "$fr_guard/parameters/gates" || return 1
  read -r active < "$fr_guard/parameters/gate_active" || return 1
  read -r failed < "$fr_guard/parameters/gate_failed" || return 1
  [[ $gates == "0" && $active == "N" && $failed == "N" ]] || return 1
  if [[ $1 == "initial" ]]; then
    [[ $armed == "0" && $consumed == "N" && -z $prefix ]]
  elif [[ $1 == "before" ]]; then
    [[ $armed == "1" && $consumed == "Y" && $prefix == "$fr_prefix" ]]
  else
    return 1
  fi
}

fr_marker_prefix() {
  local bytes
  [[ -f $fr_marker && ! -L $fr_marker ]] || return 1
  bytes=$(hexdump -v -e '/1 "%02x"' "$fr_marker") || return 1
  [[ ${#bytes} == "42" && ${bytes:0:16} == "070000004d425253" && ${bytes:40:2} == "$1" ]] || return 1
  fr_prefix=${bytes:16:24}
}

fr_witnesses_absent() {
  local name
  for name in OmarchyT2ColdPciPreArchReturned OmarchyT2ColdPreArchReturned OmarchyT2ColdPreSyscoreReturned OmarchyT2ColdPreCpuReturned; do
    [[ ! -e $fr_vars/${name}${fr_prefix}-$fr_guid && ! -L $fr_vars/${name}${fr_prefix}-$fr_guid ]] || return 1
  done
}

fr_hook_witnesses() {
  local kind stage file actual expected
  for kind in Entered Armed; do
    if [[ $kind == "Entered" ]]; then stage=1; else stage=2; fi
    file=$fr_vars/OmarchyT2RestoreHook${kind}${fr_prefix}-$fr_guid
    [[ -f $file && ! -L $file ]] || return 1
    actual=$(hexdump -v -e '/1 "%02x"' "$file") || return 1
    expected=$(printf '\007\000\000\000MBRH%s' "$fr_prefix" | hexdump -v -e '/1 "%02x"') || return 1
    [[ $actual == "${expected}0${stage}" ]] || return 1
  done
}

fr_write_arm() {
  printf '%s\n' "$fr_prefix" > "$1/parameters/arm_prefix"
}

fr_ordinary() {
  [[ $fr_header == "NORMAL" && ! -e $fr_intent && ! -L $fr_intent && ! -e $fr_marker && ! -L $fr_marker ]] || return 1
  [[ ! -e $fr_guard && ! -L $fr_guard ]] || return 1
  fr_conflicts && fr_pci ""
}

fr_prepare() {
  fr_paths && fr_header_gate || return 1
  fr_failure=ordinary-or-pending
  if [[ ! -e $fr_marker && ! -L $fr_marker ]]; then
    fr_ordinary
    return $?
  fi
  [[ $fr_header == "PENDING" && ! -e $fr_intent && ! -L $fr_intent && ! -e $fr_guard && ! -L $fr_guard ]] || return 1
  fr_marker_prefix 00 && fr_witnesses_absent && fr_conflicts && fr_pci "" || return 1
  fr_hash guard.ko && fr_hash stock-resume || return 1
  fr_failure=intent
  (umask 077; set -C; printf '%s\n' "$fr_prefix" > "$fr_intent") || return 1
  fr_failure=guard-insertion-binding
  insmod "$fr_dir/guard.ko" || return 1
  fr_identity && fr_params initial || return 1
  fr_failure=guard-arm
  fr_write_arm "$fr_guard" || return 1
  fr_params before || return 1
}

fr_before_resume() {
  local prefix armed stage
  fr_paths && fr_header_gate || return 1
  [[ ! -x $fr_root/usr/lib/systemd/systemd-hibernate-resume ]] || return 1
  if [[ ! -e $fr_intent && ! -L $fr_intent ]]; then
    fr_ordinary && fr_hash stock-resume
    return $?
  fi
  [[ $fr_header == "PENDING" && -f $fr_intent && ! -L $fr_intent ]] || return 1
  read -r prefix < "$fr_intent" || return 1
  fr_marker_prefix 00 && [[ $prefix == "$fr_prefix" ]] || return 1
  fr_witnesses_absent && fr_hook_witnesses && fr_identity && fr_hash stock-resume || return 1
  fr_params before || return 1
  read -r armed < "$fr_root/sys/module/mba_hibernate_efi_restore_marker/parameters/arm_prefix" || return 1
  read -r stage < "$fr_root/sys/module/mba_hibernate_efi_restore_marker/parameters/stage" || return 1
  [[ $armed == "1" && $stage == "0" ]]
}

fr_after_resume() {
  fr_paths || return 1
  # A successful atomic restore never reaches this restore-initramfs hook.
  # Never synthesize a source-return witness from restore-kernel execution.
  [[ ! -e $fr_intent && ! -L $fr_intent ]] || return 1
  fr_header_gate && fr_ordinary
}

fr_recovery() {
  if command -v plymouth >/dev/null 2>&1; then plymouth quit >/dev/null 2>&1 || :; fi
  err "omarchy-t2-cold-pci-restore: $*; restore initramfs stops before normal boot"
  launch_interactive_shell --exec
  # mkinitcpio ignores hook return codes. A failed console/shell exec must
  # terminate init rather than advance into resume, root mount or latehooks.
  exit 1
}

