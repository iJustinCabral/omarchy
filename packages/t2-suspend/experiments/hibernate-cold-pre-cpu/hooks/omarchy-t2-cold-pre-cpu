run_hook() {
  local cold_functions=${OMARCHY_T2_COLD_PRE_CPU_ROOT:-}/usr/lib/omarchy-t2-cold-pre-cpu/functions
  if [[ ! -f $cold_functions || -L $cold_functions ]]; then
    plymouth quit >/dev/null 2>&1 || :
    err "omarchy-t2-cold-pre-cpu: missing diagnostic functions"
    launch_interactive_shell --exec
    return 1
  fi
  cold_failure=protocol-selector
  . "$cold_functions" || {
    cold_recovery "diagnostic protocol selection failed (${cold_failure:-protocol-selector})"
    return 1
  }
  if ! cold_prepare; then
    cold_recovery "arming failed (${cold_failure:-unknown})"
    return 1
  fi
  return 0
}
