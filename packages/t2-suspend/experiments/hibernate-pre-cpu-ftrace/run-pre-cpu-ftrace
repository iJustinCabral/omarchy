#!/bin/bash

set -euo pipefail

umask 077

project=/home/jjc/Projects/MBA_9_1
state=/var/lib/codex-mba-pre-cpu-ftrace
attempts=$state/attempts
hardware_guard=$state/hardware-test-started
module=$state/mba_hibernate_pre_cpu_ftrace.ko
module_name=mba_hibernate_pre_cpu_ftrace
module_sysfs=/sys/module/$module_name
release=7.2.6-arch2-Watanare-T2-2-t2
normal_uki=/boot/EFI/Linux/omarchy_linux-t2.efi
prior_state=/var/lib/codex-mba-quiesce-kretprobe
prior_boot=26bc9b67-972b-418f-8ba8-ef5687ad12dd
prior_attempt=$prior_state/attempts/$prior_boot
expected_normal_sha256=18491469d046bd5805a10c7a80e47c1e9ae2af1879a3ce78b1e9c14826c789bc
expected_command_sha256=e47e500103e36537a8c899eaa45eed215ea4a136a8c479b766704c12739634e6
expected_module_sha256=701ecd1118c02e8c1264d00cfe356d27c8e293cef07c1d1535dcf43e393bf70b
expected_bce_srcversion=2394814A96D483B58C48501
expected_audio_srcversion=151173D6F9EEF5E4612915D
expected_wifi_srcversion=1D85357EB5E65B246EDEE20
expected_bluetooth_srcversion=4DF58889A43B9AC7E9E3E8C
marker='mba-hibernate-pre-cpu: late/noirq and platform pre-restore complete; aborting before CPU disable'

export OMARCHY_PATH=$project
export PATH=$project/bin:/usr/local/sbin:/usr/local/bin:/usr/bin

(( EUID == 0 ))

module_loaded() {
  [[ -d $module_sysfs ]]
}

disarm_module() {
  if module_loaded; then
    printf '%s\n' N > "$module_sysfs/parameters/armed" || true
  fi
}

unload_module() {
  disarm_module
  if module_loaded; then
    rmmod "$module_name" || true
  fi
}

validate_deployment() {
  [[ $(uname -r) == $release ]]
  [[ ! -e $hardware_guard ]]
  [[ -f $prior_state/hardware-test-started/boot-id ]]
  [[ $(<"$prior_state/hardware-test-started/boot-id") == "$prior_boot" ]]
  [[ $(<"$prior_attempt/classification") == "quiesce-complete" ]]
  [[ $(<"$prior_attempt/interceptions") == "1" ]]
  [[ ! -e /sys/firmware/efi/efivars/LoaderEntryOneShot-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f ]]
  [[ $(sha256sum "$normal_uki" | cut -d ' ' -f 1) == $expected_normal_sha256 ]]
  [[ $(sha256sum "$project/bin/omarchy-debug-t2-hibernate" | cut -d ' ' -f 1) == $expected_command_sha256 ]]
  [[ $(sha256sum "$module" | cut -d ' ' -f 1) == $expected_module_sha256 ]]
  [[ $(modinfo -F vermagic "$module") == "$release SMP preempt mod_unload " ]]
  [[ $(< /sys/module/t2bce_core/srcversion) == $expected_bce_srcversion ]]
  [[ $(< /sys/module/t2bce_audio/srcversion) == $expected_audio_srcversion ]]
  [[ $(< /sys/module/brcmfmac/srcversion) == $expected_wifi_srcversion ]]
  [[ $(< /sys/module/hci_bcm4377/srcversion) == $expected_bluetooth_srcversion ]]
  [[ $(< /sys/power/resume) == "253:0" ]]
  [[ $(< /sys/power/resume_offset) == "1923214" ]]
  [[ $(< /sys/power/pm_test) == "[none] core processors platform devices freezer" ]]
  [[ $(< /sys/power/disk) == "[platform] shutdown reboot suspend test_resume" ]]
  [[ $(awk '/^default_entry:/{print $2}' /boot/limine.conf) == "2" ]]
  ! grep -Fq 'MBA-Hibernate-quiesce-probe' /boot/limine.conf
  ! grep -qw 'hibernate_quiesce_probe=1' /proc/cmdline
  ! module_loaded
}

load_disarmed_module() {
  insmod "$module"
  [[ $(<"$module_sysfs/parameters/armed") == "N" ]]
  [[ $(<"$module_sysfs/parameters/interceptions") == "0" ]]
  grep -F 'hibernate_resume_nonboot_cpu_disable' /sys/kernel/tracing/enabled_functions >/dev/null
}

validate_only() {
  local result=0

  validate_deployment || result=$?
  if (( result == 0 )); then
    "$project/bin/omarchy-debug-t2-hibernate" check || result=$?
  fi
  if (( result == 0 )); then
    load_disarmed_module || result=$?
  fi
  unload_module
  if module_loaded; then
    result=1
  fi
  (( result == 0 ))
  echo "Pre-CPU-disable ftrace deployment validated without a PM transition."
}

if [[ ${1:-} == "--validate-only" ]]; then
  validate_only
  exit 0
fi

if (( $# > 0 )); then
  echo "Usage: $0 [--validate-only]" >&2
  exit 2
fi

boot_id=$(< /proc/sys/kernel/random/boot_id)
attempt=$attempts/$boot_id
mkdir -p "$attempts"
mkdir "$attempt"
printf '%s\n' "$boot_id" > "$attempt/boot-id"
cp /proc/cmdline "$attempt/cmdline"
printf '%s\n' initialized > "$attempt/phase"

recover() {
  local result=$?
  local classification=preflight-failed

  trap - EXIT
  disarm_module
  if [[ -f $hardware_guard/boot-id ]] && [[ $(<"$hardware_guard/boot-id") == "$boot_id" ]]; then
    classification=marker-absent
    if journalctl -b -k --no-pager | grep -F "$marker" >/dev/null; then
      classification=pre-cpu-complete
    fi
  fi
  if module_loaded; then
    cat "$module_sysfs/parameters/interceptions" > "$attempt/interceptions" || true
  fi
  unload_module
  printf '%s\n' "$result" > "$attempt/runner-status"
  printf '%s\n' "$classification" > "$attempt/classification"
  journalctl -b -k --no-pager > "$attempt/kernel.log" || true
  journalctl -b -u mba-pre-cpu-ftrace-probe.service --no-pager > "$attempt/service.log" || true
  journalctl -b -t omarchy-t2-hibernate-test --no-pager > "$attempt/test-journal.log" || true
  systemctl show mba-pre-cpu-ftrace-probe.service > "$attempt/service-state" || true
  systemctl stop mba-pre-cpu-ftrace-recovery.timer >/dev/null 2>&1 || true
  logger -t mba-pre-cpu-ftrace "probe finished result=$result classification=$classification; rebooting to clear diagnostic swap allocations"
  install -d -m 0700 -o jjc -g jjc /home/jjc/.local/state/codex-mba-autonomous
  install -m 0600 -o jjc -g jjc /dev/null /home/jjc/.local/state/codex-mba-autonomous/continue
  rm -f /home/jjc/.local/state/codex-mba-autonomous/continue.dispatched
  journalctl --sync || true
  sync
  systemctl reboot
}

trap recover EXIT

systemd-run \
  --unit=mba-pre-cpu-ftrace-recovery \
  --on-active=300s \
  --timer-property=AccuracySec=1s \
  /usr/bin/systemctl reboot

validate_deployment > "$attempt/deployment-validation.log" 2>&1
printf '%s\n' "$release" > "$attempt/kernel-release"
printf '%s\n' deployment-validated > "$attempt/phase"

"$project/bin/omarchy-debug-t2-hibernate" check > "$attempt/preflight.log" 2>&1
printf '%s\n' preflight-passed > "$attempt/phase"

load_disarmed_module
printf '%s\n' module-loaded-disarmed > "$attempt/phase"

# This mkdir is the atomic hardware-attempt guard. Never remove it to retry
# an invocation that reached this point. It is created only after all gates.
mkdir "$hardware_guard"
printf '%s\n' "$boot_id" > "$hardware_guard/boot-id"
printf '%s\n' "$attempt" > "$hardware_guard/evidence-directory"
printf '%s\n' hardware-test-started > "$attempt/phase"
printf '%s\n' Y > "$module_sysfs/parameters/armed"
[[ $(<"$module_sysfs/parameters/armed") == "Y" ]]
journalctl --sync
sync

set +e
"$project/bin/omarchy-debug-t2-hibernate" test test-resume --wifi-unbind --bluetooth-off --pm-trace --no-sudo-prompt --yes \
  > >(tee "$attempt/test.log") 2>&1
test_status=$?
set -e
printf '%s\n' N > "$module_sysfs/parameters/armed"
printf '%s\n' "$test_status" > "$attempt/test-status"
printf '%s\n' hardware-test-returned > "$attempt/phase"

[[ $(<"$module_sysfs/parameters/interceptions") == "1" ]]
journalctl -b -k --no-pager | grep -F "$marker" >/dev/null
