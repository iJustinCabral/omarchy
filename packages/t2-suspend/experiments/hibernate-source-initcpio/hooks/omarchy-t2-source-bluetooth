# This file is sourced by mkinitcpio's ash runtime, not executed directly.

run_latehook() (
  candidate_root=${OMARCHY_T2_CANDIDATE_ROOT:-}
  candidate_release=$(cat "$candidate_root/proc/sys/kernel/osrelease") || return 1
  candidate_module=$(find "$candidate_root/usr/lib/modules/$candidate_release" -type f -name hci_bcm4377.ko) || return 1
  set -- $candidate_module
  if [ "$#" -ne 1 ]; then
    echo "omarchy-t2-source: expected one private hci_bcm4377 module, found $#" >&2
    return 1
  fi

  candidate_source=$1
  candidate_state=$candidate_root/run/omarchy-t2-hibernation-candidate
  candidate_systemd=$candidate_root/run/systemd
  candidate_system=$candidate_systemd/system
  candidate_dropin=$candidate_system/bluetooth-after-wifi.service.d
  candidate_helper=$candidate_root/usr/lib/omarchy-t2-hibernation-candidate/bluetooth-after-wifi.py
  candidate_marker=$candidate_root/usr/lib/omarchy-t2-hibernation-candidate/source-experiment-id
  if [ ! -f "$candidate_helper" ] || [ ! -f "$candidate_marker" ]; then
    echo "omarchy-t2-source: userspace Bluetooth gate or source marker is missing" >&2
    return 1
  fi
  if [ -e "$candidate_state" ]; then
    echo "omarchy-t2-source: refusing to overwrite candidate runtime state" >&2
    return 1
  fi

  umask 077
  mkdir -p "$candidate_state" "$candidate_dropin" || return 1
  chmod 755 "$candidate_systemd" "$candidate_system" "$candidate_dropin" || return 1
  cp "$candidate_source" "$candidate_state/hci_bcm4377.ko" || return 1
  cp "$candidate_helper" "$candidate_state/bluetooth-after-wifi.py" || return 1
  cp "$candidate_marker" "$candidate_state/source-experiment-id" || return 1
  candidate_source_hash=$(sha256sum "$candidate_source" | awk '{print $1}') || return 1
  candidate_copy_hash=$(sha256sum "$candidate_state/hci_bcm4377.ko" | awk '{print $1}') || return 1
  if [ "$candidate_source_hash" != "$candidate_copy_hash" ]; then
    echo "omarchy-t2-source: copied Bluetooth module hash mismatch" >&2
    return 1
  fi
  printf '%s\n' "$candidate_copy_hash" > "$candidate_state/hci_bcm4377.sha256" || return 1
  chmod 600 "$candidate_state/hci_bcm4377.ko" "$candidate_state/hci_bcm4377.sha256" "$candidate_state/source-experiment-id" || return 1
  chmod 700 "$candidate_state/bluetooth-after-wifi.py" || return 1
  cat > "$candidate_dropin/50-hibernation-candidate.conf" <<'EOF' || return 1
[Service]
ExecStart=
ExecStart=/usr/bin/python3 /run/omarchy-t2-hibernation-candidate/bluetooth-after-wifi.py
EOF
  chmod 644 "$candidate_dropin/50-hibernation-candidate.conf" || return 1
  echo "omarchy-t2-source: private Bluetooth driver staged for post-Wi-Fi loading"
)
