#!/bin/bash

# omarchy:summary=Inspect and run guarded T2 hibernation diagnostics
# omarchy:group=debug
# omarchy:args=<check|test> [freezer|devices|platform|processors|core|snapshot-create|test-resume] [--bluetooth-off] [--wifi-unbind] [--pm-trace] [--disk-mode <platform|shutdown>] [--no-sudo-prompt] [--yes]
# omarchy:examples=omarchy debug t2-hibernate check | omarchy debug t2-hibernate test freezer --bluetooth-off

set -euo pipefail

SYS_POWER=${OMARCHY_T2_HIBERNATE_SYS_POWER:-/sys/power}
DMI_ROOT=${OMARCHY_T2_HIBERNATE_DMI_ROOT:-/sys/class/dmi/id}
CMDLINE_FILE=${OMARCHY_T2_HIBERNATE_CMDLINE:-/proc/cmdline}
BRCMFMAC_SRCVERSION_FILE=${OMARCHY_T2_HIBERNATE_BRCMFMAC_SRCVERSION:-/sys/module/brcmfmac/srcversion}
T2BCE_AUDIO_SRCVERSION_FILE=${OMARCHY_T2_HIBERNATE_T2BCE_AUDIO_SRCVERSION:-/sys/module/t2bce_audio/srcversion}
BRCMFMAC_DRIVER=${OMARCHY_T2_HIBERNATE_BRCMFMAC_DRIVER:-/sys/bus/pci/drivers/brcmfmac}
SNAPSHOT_HELPER=${OMARCHY_T2_SNAPSHOT_HELPER:-}
TESTED_MODEL="MacBookAir9,1"
UNSAFE_RESTORE_SRCVERSION="5D40EE47A0592AA2E41E149"
REQUIRED_AUDIO_RESTORE_SRCVERSION="151173D6F9EEF5E4612915D"
TEST_CLEANUP_ARMED=false
TEST_PREVIOUS_PM_TEST=""
TEST_PREVIOUS_DISK=""
TEST_PREVIOUS_PM_TRACE=""
TEST_BLUETOOTH_WAS_POWERED=false
TEST_WIFI_DEVICE=""
TEST_SUDO_ARGS=()

usage() {
  cat <<'USAGE'
Usage:
  omarchy debug t2-hibernate check
  omarchy debug t2-hibernate test <freezer|devices|platform|processors|core|snapshot-create|test-resume> [--bluetooth-off] [--wifi-unbind] [--pm-trace] [--disk-mode <platform|shutdown>] [--no-sudo-prompt] [--yes]

The check is read-only. Tests use the kernel's direct hibernation test
interface and can still freeze or reboot a broken machine. They do not change
persistent boot configuration.

Start with:
  omarchy debug t2-hibernate test freezer --bluetooth-off

Use --disk-mode shutdown to skip ACPI S4 platform preparation while retaining
the selected PM test depth. The prior hibernation mode is restored afterward.

Use --wifi-unbind to detach the single BCM4377 Wi-Fi PCI function before the
test and bind it again afterward. Network access will be interrupted. This
isolates image-rewound Wi-Fi queues; a pass does not validate Wi-Fi restore.

snapshot-create requires the compiled laboratory helper specified by
OMARCHY_T2_SNAPSHOT_HELPER. It creates and discards an in-memory image without
writing it to swap, restoring it, or entering ACPI S4.

Use --pm-trace to store the last device PM callback in the RTC so the next boot
can identify a hard hang. This temporarily disturbs the hardware clock; network
time should correct it after reboot. Reboot promptly after a hang.

The command asks for confirmation unless --yes is supplied. --yes only skips
the prompt; it does not make a power test safe.

Use --no-sudo-prompt only from an unattended harness that has already arranged
passwordless sudo. It fails before isolation or PM changes if authorization is
not immediately available.
USAGE
}

selected_value() {
  local file="$1"
  sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$file"
}

available_value() {
  local file="$1"
  local wanted="$2"
  local value

  for value in $(tr -d '[]' <"$file"); do
    [[ $value == "$wanted" ]] && return 0
  done

  return 1
}

resume_arguments() {
  local argument
  local found=false

  for argument in $(<"$CMDLINE_FILE"); do
    case "$argument" in
      resume=* | resume_offset=*)
        printf '  %s\n' "$argument"
        found=true
        ;;
    esac
  done

  if ! $found; then
    echo "  none"
  fi
}

bluetooth_powered() {
  timeout 2s bluetoothctl show 2>/dev/null | grep -Fq "Powered: yes"
}

bluetooth_unpowered() {
  timeout 2s bluetoothctl show 2>/dev/null | grep -Fq "Powered: no"
}

wait_for_bluetooth_power() {
  local expected="$1"
  local deadline=$((SECONDS + 5))

  while (( SECONDS < deadline )); do
    if [[ $expected == "on" ]] && bluetooth_powered; then
      return 0
    elif [[ $expected == "off" ]] && bluetooth_unpowered; then
      return 0
    fi
    sleep 0.2
  done

  return 1
}

check_hardware() {
  if ! omarchy-hw-t2; then
    echo "This command only supports Apple T2 hardware." >&2
    exit 1
  fi
}

check_power_interface() {
  local required

  for required in state disk pm_test image_size; do
    if [[ ! -r "$SYS_POWER/$required" ]]; then
      echo "Missing hibernation interface: $SYS_POWER/$required" >&2
      exit 1
    fi
  done

  if ! available_value "$SYS_POWER/state" disk; then
    echo "The running kernel does not advertise the disk sleep state." >&2
    exit 1
  fi
}

show_check() {
  local model="unknown"
  local board="unknown"
  local trace_match=""

  check_hardware
  check_power_interface
  [[ -r "$DMI_ROOT/product_name" ]] && model=$(<"$DMI_ROOT/product_name")
  [[ -r "$DMI_ROOT/board_name" ]] && board=$(<"$DMI_ROOT/board_name")

  echo "T2 hibernation diagnostic"
  echo "  model: $model"
  echo "  board: $board"
  echo "  kernel: $(uname -r)"
  echo "  power states: $(<"$SYS_POWER/state")"
  echo "  hibernation modes: $(<"$SYS_POWER/disk")"
  echo "  PM test levels: $(<"$SYS_POWER/pm_test")"
  if [[ -r "$SYS_POWER/pm_trace" ]]; then
    echo "  PM trace: $(<"$SYS_POWER/pm_trace")"
  fi
  if [[ -r "$SYS_POWER/pm_trace_dev_match" ]]; then
    trace_match=$(<"$SYS_POWER/pm_trace_dev_match")
    if [[ -n $trace_match ]]; then
      echo "  PM trace device match: $trace_match"
    fi
  fi
  echo "  image size limit: $(<"$SYS_POWER/image_size") bytes"
  if [[ -r "$SYS_POWER/resume" && -r "$SYS_POWER/resume_offset" ]]; then
    echo "  kernel resume target: $(<"$SYS_POWER/resume") offset $(<"$SYS_POWER/resume_offset")"
  fi
  echo "  resume arguments:"
  resume_arguments
  echo "  active swap:"
  swapon --show=NAME,SIZE,PRIO --noheadings 2>/dev/null | sed 's/^/    /' || echo "    unavailable"

  if bluetooth_powered; then
    echo "  Bluetooth: powered"
  else
    echo "  Bluetooth: off or unavailable"
  fi

  if [[ $model != "$TESTED_MODEL" ]]; then
    echo
    echo "Only $TESTED_MODEL is currently qualified for live tests."
  fi
}

write_power_setting() {
  local file="$1"
  local value="$2"
  printf '%s\n' "$value" | sudo "${TEST_SUDO_ARGS[@]}" tee "$file" >/dev/null
}

restore_test_state() {
  local cleanup_status=0
  local attempt
  local bluetooth_restored=false
  if ! $TEST_CLEANUP_ARMED; then
    return 0
  fi

  TEST_CLEANUP_ARMED=false
  if [[ -n $TEST_PREVIOUS_PM_TEST ]]; then
    write_power_setting "$SYS_POWER/pm_test" "$TEST_PREVIOUS_PM_TEST" || true
  fi
  if [[ -n $TEST_PREVIOUS_DISK ]]; then
    write_power_setting "$SYS_POWER/disk" "$TEST_PREVIOUS_DISK" || true
  fi
  if [[ -n $TEST_PREVIOUS_PM_TRACE ]]; then
    write_power_setting "$SYS_POWER/pm_trace" "$TEST_PREVIOUS_PM_TRACE" || true
  fi
  if [[ -n $TEST_WIFI_DEVICE && ! -L "$BRCMFMAC_DRIVER/$TEST_WIFI_DEVICE" ]]; then
    if ! write_power_setting "$BRCMFMAC_DRIVER/bind" "$TEST_WIFI_DEVICE" || [[ ! -L "$BRCMFMAC_DRIVER/$TEST_WIFI_DEVICE" ]]; then
      echo "Failed to rebind Wi-Fi $TEST_WIFI_DEVICE; inspect the kernel journal before further testing." >&2
      cleanup_status=1
    fi
  fi
  TEST_WIFI_DEVICE=""
  if $TEST_BLUETOOTH_WAS_POWERED; then
    for attempt in 1 2 3; do
      if timeout 5s bluetoothctl power on >/dev/null 2>&1 && wait_for_bluetooth_power on; then
        bluetooth_restored=true
        break
      fi
      logger --tag omarchy-t2-hibernate-test "Bluetooth restoration attempt=$attempt failed"
      if (( attempt < 3 )); then
        sleep 1
      fi
    done
    if ! $bluetooth_restored; then
      echo "Failed to restore Bluetooth power; inspect the controller before further testing." >&2
      cleanup_status=1
    fi
  fi
  return "$cleanup_status"
}

isolate_wifi() {
  local device
  local -a devices=()

  for device in "$BRCMFMAC_DRIVER"/????:??:??.?; do
    [[ -L $device ]] && devices+=("$device")
  done
  if (( ${#devices[@]} != 1 )); then
    echo "Wi-Fi isolation requires exactly one bound brcmfmac PCI device." >&2
    return 1
  fi
  device=${devices[0]}
  if [[ $(<"$device/vendor") != "0x14e4" || $(<"$device/device") != "0x4488" ]]; then
    echo "Wi-Fi isolation is only qualified for BCM4377 (14e4:4488)." >&2
    return 1
  fi

  TEST_WIFI_DEVICE=${device##*/}
  logger --tag omarchy-t2-hibernate-test "unbinding wifi=$TEST_WIFI_DEVICE"
  if ! write_power_setting "$BRCMFMAC_DRIVER/unbind" "$TEST_WIFI_DEVICE" || [[ -L $device ]]; then
    echo "Wi-Fi did not detach; refusing to start the PM test." >&2
    return 1
  fi
  echo "Wi-Fi detached before image creation; it will be rebound when the test returns."
}

run_test() {
  local stage="$1"
  shift
  local bluetooth_off=false
  local wifi_unbind=false
  local pm_trace=false
  local assume_yes=false
  local no_sudo_prompt=false
  local disk_mode=""
  local model="unknown"

  while (( $# > 0 )); do
    case "$1" in
      --bluetooth-off)
        bluetooth_off=true
        ;;
      --wifi-unbind)
        wifi_unbind=true
        ;;
      --pm-trace)
        pm_trace=true
        ;;
      --yes)
        assume_yes=true
        ;;
      --no-sudo-prompt)
        no_sudo_prompt=true
        ;;
      --disk-mode)
        shift
        if (( $# == 0 )); then
          echo "--disk-mode requires platform or shutdown." >&2
          exit 1
        fi
        disk_mode="$1"
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
    shift
  done

  check_hardware
  check_power_interface
  if [[ -n $disk_mode && $disk_mode != "platform" && $disk_mode != "shutdown" ]]; then
    echo "Unsupported hibernation disk mode: $disk_mode" >&2
    exit 1
  fi
  if [[ $stage == "test-resume" && -n $disk_mode ]]; then
    echo "test-resume selects its own disk mode; do not pass --disk-mode." >&2
    exit 1
  fi
  if [[ $stage == "snapshot-create" && -n $disk_mode ]]; then
    echo "snapshot-create disables platform support; do not pass --disk-mode." >&2
    exit 1
  fi
  if [[ -n $disk_mode ]] && ! available_value "$SYS_POWER/disk" "$disk_mode"; then
    echo "The running kernel does not support the '$disk_mode' hibernation mode." >&2
    exit 1
  fi
  if $pm_trace && [[ ! -r "$SYS_POWER/pm_trace" ]]; then
    echo "The running kernel does not provide PM trace support." >&2
    exit 1
  fi
  [[ -r "$DMI_ROOT/product_name" ]] && model=$(<"$DMI_ROOT/product_name")
  if [[ $model != "$TESTED_MODEL" ]]; then
    echo "Live hibernation tests are currently restricted to $TESTED_MODEL; found $model." >&2
    exit 1
  fi

  case "$stage" in
    snapshot-create)
      if [[ $SNAPSHOT_HELPER != /* || ! -x $SNAPSHOT_HELPER ]]; then
        echo "snapshot-create requires an absolute executable OMARCHY_T2_SNAPSHOT_HELPER path." >&2
        exit 1
      fi
      ;;
    freezer | devices | platform | processors | core)
      if ! available_value "$SYS_POWER/pm_test" "$stage"; then
        echo "The running kernel does not support the '$stage' PM test level." >&2
        exit 1
      fi
      ;;
    test-resume)
      if ! available_value "$SYS_POWER/disk" test_resume; then
        echo "The running kernel does not support test_resume." >&2
        exit 1
      fi
      if [[ -r $BRCMFMAC_SRCVERSION_FILE && $(<"$BRCMFMAC_SRCVERSION_FILE") == "$UNSAFE_RESTORE_SRCVERSION" ]]; then
        echo "The loaded brcmfmac module has the rejected restore-time FLR implementation; refusing test_resume." >&2
        echo "Install the corrected T2 suspend driver package and reboot before any further image-restore test." >&2
        exit 1
      fi
      if [[ ! -r $T2BCE_AUDIO_SRCVERSION_FILE || $(<"$T2BCE_AUDIO_SRCVERSION_FILE") != "$REQUIRED_AUDIO_RESTORE_SRCVERSION" ]]; then
        echo "The loaded T2 audio module lacks the qualified hibernation callbacks; refusing test_resume." >&2
        echo "Install T2 suspend driver package 1.5 and reboot before any further image-restore test." >&2
        exit 1
      fi
      if [[ ! -r "$SYS_POWER/resume" || $(<"$SYS_POWER/resume") == "0:0" ]]; then
        echo "The running kernel has no resume device configured; refusing test_resume." >&2
        exit 1
      fi
      ;;
    *)
      echo "Unknown test stage: $stage" >&2
      usage >&2
      exit 1
      ;;
  esac

  echo "About to run the '$stage' kernel hibernation test on $model."
  if [[ $stage == "freezer" ]]; then
    echo "This exercises hibernation preparation and process freezing without suspending devices or entering ACPI S4."
  elif [[ $stage == "snapshot-create" ]]; then
    echo "This creates and discards a memory image without saving or restoring it. Save all work first."
  elif [[ $stage == "test-resume" ]]; then
    echo "This writes and immediately restores a hibernation image without entering ACPI S4. Save all work first."
  else
    echo "This suspends part of the live device/platform stack. Save all work first."
  fi
  echo "A kernel or driver fault can still require a forced restart."
  if $wifi_unbind; then
    echo "Wi-Fi will be detached for this test; network access will be interrupted."
  fi
  if [[ -n $disk_mode ]]; then
    echo "The hibernation disk mode will be temporarily set to '$disk_mode'."
  fi
  if $pm_trace; then
    echo "PM trace will encode the last device callback in the RTC for the next boot."
    echo "The hardware clock may be temporarily wrong; reboot promptly after a hang."
  fi

  if ! $assume_yes && ! gum confirm "Run the $stage test now?"; then
    echo "Cancelled."
    return 0
  fi

  TEST_SUDO_ARGS=()
  if $no_sudo_prompt; then
    TEST_SUDO_ARGS=(-n)
    sudo -n true
  else
    sudo -v
  fi
  TEST_PREVIOUS_PM_TEST=$(selected_value "$SYS_POWER/pm_test")
  TEST_PREVIOUS_DISK=$(selected_value "$SYS_POWER/disk")
  TEST_PREVIOUS_PM_TRACE=""
  if $pm_trace; then
    TEST_PREVIOUS_PM_TRACE=$(<"$SYS_POWER/pm_trace")
  fi
  TEST_BLUETOOTH_WAS_POWERED=false
  TEST_CLEANUP_ARMED=true
  trap restore_test_state EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  if $bluetooth_off; then
    if bluetooth_powered; then
      TEST_BLUETOOTH_WAS_POWERED=true
      timeout 5s bluetoothctl power off >/dev/null
      if ! wait_for_bluetooth_power off; then
        echo "Bluetooth did not power down; refusing to start the PM test." >&2
        exit 1
      fi
      echo "Bluetooth powered down for notifier isolation."
    elif bluetooth_unpowered; then
      echo "Bluetooth was already off."
    else
      echo "Bluetooth power could not be verified; refusing the isolation test." >&2
      exit 1
    fi
  fi

  if $wifi_unbind; then
    isolate_wifi
  fi

  if [[ $stage == "snapshot-create" ]]; then
    write_power_setting "$SYS_POWER/pm_test" none
  elif [[ $stage == "test-resume" ]]; then
    write_power_setting "$SYS_POWER/pm_test" none
    write_power_setting "$SYS_POWER/disk" test_resume
  else
    if [[ -n $disk_mode ]]; then
      write_power_setting "$SYS_POWER/disk" "$disk_mode"
    fi
    write_power_setting "$SYS_POWER/pm_test" "$stage"
  fi

  if $pm_trace; then
    write_power_setting "$SYS_POWER/pm_trace" 1
  fi

  sync
  if [[ -n $TEST_WIFI_DEVICE && -L "$BRCMFMAC_DRIVER/$TEST_WIFI_DEVICE" ]]; then
    echo "Wi-Fi rebound unexpectedly; refusing to start the PM test." >&2
    return 1
  fi
  logger --tag omarchy-t2-hibernate-test "starting stage=$stage bluetooth_off=$bluetooth_off pm_trace=$pm_trace disk_mode=${disk_mode:-current} wifi_unbind=$wifi_unbind"
  echo "Entering kernel test..."
  local transition_status=0
  if [[ $stage == "snapshot-create" ]]; then
    sudo "${TEST_SUDO_ARGS[@]}" "$SNAPSHOT_HELPER" --create-and-discard || transition_status=$?
  else
    write_power_setting "$SYS_POWER/state" disk || transition_status=$?
  fi
  if (( transition_status != 0 )); then
    logger --tag omarchy-t2-hibernate-test "failed stage=$stage bluetooth_off=$bluetooth_off pm_trace=$pm_trace disk_mode=${disk_mode:-current} wifi_unbind=$wifi_unbind"
    echo "The kernel rejected the '$stage' test. Inspect the kernel journal before retrying." >&2
    return 1
  fi
  logger --tag omarchy-t2-hibernate-test "returned stage=$stage bluetooth_off=$bluetooth_off pm_trace=$pm_trace disk_mode=${disk_mode:-current} wifi_unbind=$wifi_unbind"
  restore_test_state
  trap - EXIT INT TERM
  echo "The '$stage' test returned successfully."
}

case "${1:-}" in
  check)
    (( $# == 1 )) || {
      usage >&2
      exit 1
    }
    show_check
    ;;
  test)
    (( $# >= 2 )) || {
      usage >&2
      exit 1
    }
    stage="$2"
    shift 2
    run_test "$stage" "$@"
    ;;
  -h | --help | "")
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
