#!/bin/bash

# omarchy:summary=Hibernate using the explicitly opted-in T2 lifecycle or system default

# This marker selects a route, not qualification or permission to touch power.
# Provision it only after installing the root-owned runtime and reviewed unit.
OPT_IN="/etc/omarchy/t2-hibernate-product.enabled"
MODEL="/sys/class/dmi/id/product_name"

if (( $# != 0 )); then
  echo "Usage: omarchy system hibernate" >&2
  exit 2
fi

if [[ ! -e $OPT_IN && ! -L $OPT_IN ]]; then
  systemctl hibernate
else
  if [[ -L $OPT_IN || ! -f $OPT_IN ]] || [[ $(stat -c '%u:%g:%a:%s' -- "$OPT_IN") != "0:0:644:0" ]]; then
    echo "Invalid T2 hibernation opt-in marker; refusing fallback" >&2
    exit 1
  fi
  if [[ $(cat "$MODEL") != "MacBookAir9,1" ]] || ! omarchy-hw-t2; then
    echo "T2 hibernation opt-in is qualified only for MacBookAir9,1; refusing fallback" >&2
    exit 1
  fi
  # Requesting users confirm their own lock before logind admission. The root
  # dispatcher independently binds and rechecks the active graphical session.
  if (( EUID != 0 )); then
    if ! omarchy-system-sleep-lock; then
      echo "Desktop lock was not secured; refusing hibernation" >&2
      exit 1
    fi
  fi
  # logind owns inhibitor admission, delay waiting and PrepareForSleep signals.
  # Never start the product service/target directly or bypass inhibitors.
  # ROOT_CHECK_INHIBITORS (1); interactive authorization is in the bus header.
  # A direct bus call cannot fall back to an untracked target when logind fails.
  busctl --system --allow-interactive-authorization=yes call \
    org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager HibernateWithFlags t 1
fi
