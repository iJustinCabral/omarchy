#!/bin/bash

# omarchy:summary=Enable T2 Mac speaker and microphone DSP for this machine
# omarchy:group=audio
# omarchy:args=<on|off|status>
# omarchy:examples=omarchy t2 audio-dsp status | omarchy t2 audio-dsp on | omarchy t2 audio-dsp off

set -euo pipefail

action="${1:-status}"

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
wp_conf="$config_home/wireplumber/wireplumber.conf.d/50-t2-audio-dsp.conf"
wp_disabled="$wp_conf.disabled"
rendered_dir="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy/t2-audio-dsp"
profiles_root="${OMARCHY_T2_AUDIO_ROOT:-$OMARCHY_PATH/default/audio/t2linux}"

usage() {
  echo "Usage: omarchy-t2-audio-dsp <on|off|status>" >&2
  exit 2
}

model_dir() {
  omarchy-hw-t2-audio-dsp
}

needs_swh() {
  local graph="$1"
  grep -Fq 'plugin.org.uk/swh-plugins/fastLookaheadLimiter' "$graph"
}

render_json() {
  local src="$1" dest="$2" audio_dir="$3"
  python3 - "$src" "$dest" "$audio_dir" <<'PY'
import json, pathlib, sys
src, dest, audio_dir = sys.argv[1], sys.argv[2], sys.argv[3]
text = pathlib.Path(src).read_text()
text = text.replace("@T2_AUDIO_DIR@", audio_dir.rstrip("/"))
pathlib.Path(dest).write_text(text)
json.loads(text)
PY
}

write_wp_conf() {
  local audio_dir="$1" has_mic="$2"
  local graph="$audio_dir/graph.json"
  local mic="$audio_dir/mic.json"

  mkdir -p "$(dirname "$wp_conf")"
  cat >"$wp_conf" <<EOF
# Generated by omarchy-t2-audio-dsp. Do not edit.
# Profile: $audio_dir

wireplumber.profiles = {
    main = {
        node.software-dsp = required
    }
}

monitor.alsa.rules = [
    {
        matches = [
            {
                api.alsa.card.name = "Apple T2 Audio"
                node.name = "~alsa_output.*.HiFi__Speaker__sink"
            }
        ]
        actions = {
            update-props = {
                audio.allowed-rates = [ 96000, 88200, 48000, 44100 ]
                node.name = "alsa_output.platform-sound.RawSpeakers"
                node.description = "Raw Speaker Device (do not use)"
                node.nick = "RawSpeakers"
            }
        }
    }
    {
        matches = [
            {
                api.alsa.card.name = "Apple T2 Audio"
                node.name = "~alsa_input.*.HiFi__Mic__source"
            }
        ]
        actions = {
            update-props = {
                node.name = "alsa_input.platform-sound.RawMics"
                node.description = "Raw Mic Device (do not use)"
                node.nick = "RawMics"
            }
        }
    }
]

node.software-dsp.rules = [
    {
        matches = [
            { node.name = "alsa_output.platform-sound.RawSpeakers" }
        ]
        actions = {
            create-filter = {
                filter-path = "$graph"
                hide-parent = true
            }
        }
    }
EOF

  if [[ $has_mic == "yes" ]]; then
    cat >>"$wp_conf" <<EOF
    {
        matches = [
            { node.name = "alsa_input.platform-sound.RawMics" }
        ]
        actions = {
            create-filter = {
                filter-path = "$mic"
                hide-parent = true
            }
        }
    }
EOF
  fi

  cat >>"$wp_conf" <<'EOF'
]
EOF
}

reload_wp() {
  if systemctl --user --quiet is-active wireplumber.service 2>/dev/null; then
    systemctl --user restart wireplumber.service
  fi
}

dsp_live() {
  pactl list short sinks 2>/dev/null | grep -q 'alsa_output.t2-speakers'
}

case "$action" in
  status)
    if [[ -f $wp_conf ]]; then
      echo "Config:   enabled ($wp_conf)"
    elif [[ -f $wp_disabled ]]; then
      echo "Config:   disabled ($wp_disabled)"
    else
      echo "Config:   missing"
    fi
    if model=$(model_dir 2>/dev/null); then
      echo "Profile:  $model"
    else
      echo "Profile:  none for this machine"
    fi
    echo "Sink:     $(pactl get-default-sink 2>/dev/null || echo none)"
    echo "Source:   $(pactl get-default-source 2>/dev/null || echo none)"
    if dsp_live; then
      echo "Speakers: DSP live"
    else
      echo "Speakers: DSP not in graph"
    fi
    if pactl list short sources 2>/dev/null | grep -q 'alsa_input.t2-mic'; then
      echo "Mic:      DSP live"
    else
      echo "Mic:      DSP not in graph"
    fi
    ;;

  off)
    if [[ ! -f $wp_conf && ! -f $wp_disabled ]]; then
      echo "No T2 DSP config installed."
      exit 0
    fi
    if [[ -f $wp_conf ]]; then
      mv "$wp_conf" "$wp_disabled"
    fi
    reload_wp
    echo "T2 speaker/mic DSP disabled."
    ;;

  on)
    model=$(model_dir) || {
      echo "No T2 speaker/mic DSP profile ships for this machine."
      exit 0
    }

    src="$profiles_root/$model"
    [[ -r $src/graph.json ]] || {
      echo "Missing DSP graph at $src/graph.json" >&2
      exit 1
    }

    omarchy-pkg-add lsp-plugins-lv2
    aur_pkgs=(bankstown triforce)
    if needs_swh "$src/graph.json"; then
      aur_pkgs+=(swh-lv2-git)
    fi
    if omarchy-pkg-aur-accessible; then
      omarchy-pkg-aur-add "${aur_pkgs[@]}"
    elif omarchy-pkg-missing "${aur_pkgs[@]}"; then
      echo "AUR packages required for T2 DSP are missing: ${aur_pkgs[*]}" >&2
      echo "Install them, then re-run: omarchy t2 audio-dsp on" >&2
      exit 1
    fi

    mkdir -p "$rendered_dir/$model"
    cp -a "$src/." "$rendered_dir/$model/"
    render_json "$src/graph.json" "$rendered_dir/$model/graph.json" "$rendered_dir/$model"
    has_mic=no
    if [[ -r $src/mic.json ]]; then
      render_json "$src/mic.json" "$rendered_dir/$model/mic.json" "$rendered_dir/$model"
      has_mic=yes
    fi

    write_wp_conf "$rendered_dir/$model" "$has_mic"
    rm -f "$wp_disabled"
    reload_wp
    echo "Installed T2 DSP profile $model."
    echo "Volume keys control the DSP sink; the raw device stays at 100% behind the limiter."
    ;;

  *)
    usage
    ;;
esac
